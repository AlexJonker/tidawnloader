{
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^10.0.4"
  },
  "scripts": {
    "dev": "concurrently --raw \"npm run watch:css\" \"dotnet watch\"",
    "build:css": "tailwindcss -i wwwroot/app.css -o wwwroot/tailwind.css",
    "build:minified:css": "tailwindcss -i wwwroot/app.css -o wwwroot/tailwind.css --minify",
    "watch:css": "tailwindcss -i wwwroot/app.css -o wwwroot/tailwind.css --watch",
    "update-deps": "dotnet tool install --global dotnet-outdated-tool && dotnet outdated --upgrade --recursive && npx npm-check-updates -u && npm update && npm i"
  }
}
