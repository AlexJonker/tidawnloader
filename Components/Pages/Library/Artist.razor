@page "/library/artist/{Id:int}"
@using Tidawnloader.Data
@using Tidawnloader.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
<PageTitle>@ArtistInfo.Name</PageTitle>

<div>
    <img
        src="@($"https://resources.tidal.com/images/{ArtistInfo.Picture.Replace("-", "/")}/750x750.jpg")"
        alt="Picture"
        class="w-48 h-48 object-cover"
    />
    <h1 class="text-4xl font-bold text-gray-200">@ArtistInfo.Name</h1>
    <a href="@ArtistInfo.Url" target="_blank" class="text-sm text-gray-400">Tidal url</a>

</div>

@code {
    [Parameter] public int Id { get; set; }

    private DbArtist ArtistInfo { get; set; } = new();

    protected override void OnInitialized()
    {
        ArtistInfo = Db.Artists.FirstOrDefault(a => a.Id == Id) ?? new DbArtist();
    }
}