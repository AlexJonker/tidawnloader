@page "/artist/{Id:int}"
@using Tidawnloader.Data
@using Tidawnloader.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
<PageTitle>@(ArtistInfo?.Name ?? "Artist not found")</PageTitle>

@if (ArtistInfo is null)
{
    <div class="min-h-screen flex items-center justify-center px-4">
        <div class="flex-1 flex flex-col items-center justify-center text-center">
            <h1 class="text-6xl font-bold text-gray-300 mb-4">Artist not found</h1>
            <p class="text-gray-400 max-w-xl mb-8">The artist you are looking for does not exist in your library.</p>
            <a href="/" class="bg-gray-200 text-black px-5 py-2 font-semibold hover:bg-white transition-colors duration-75 cursor-pointer">Back to library</a>
        </div>
    </div>
}
else
{
    <div class="gap-6 flex flex-col">
        <div class="flex flex-col md:flex-row items-center gap-6">
            <img
                src="@($"https://resources.tidal.com/images/{ArtistInfo.Picture!.Replace("-", "/")}/750x750.jpg")"
                alt="Picture"
                class="w-48 h-48 object-cover"
            />
            <div class="flex flex-col items-center md:items-start text-center md:text-left gap-2">
                <h1 class="text-4xl font-bold text-gray-200">@ArtistInfo.Name</h1>
                <p>@ArtistAlbums.Count albums</p>
                <a href="https://tidal.com/artist/@ArtistInfo.Id" target="_blank" class="text-sm text-gray-400">Tidal url</a>
                <a href="https://monochrome.tf/artist/@ArtistInfo.Id" target="_blank" class="text-sm text-gray-400">Monochrome url</a>
            </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
            @foreach (var album in ArtistAlbums)
            {
                <a href="/album/@album.Id" class="relative aspect-square overflow-hidden block group">
                    <img src="@($"https://resources.tidal.com/images/{album.Cover.Replace("-", "/")}/320x320.jpg")"
                         class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300" />
                    <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/10 to-transparent"></div>
                    <p class="absolute bottom-0 left-0 right-0 px-2 py-2 text-sm font-medium text-white truncate">
                        @album.Title
                    </p>
                </a>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private DbArtist? ArtistInfo { get; set; }
    private List<DbAlbum> ArtistAlbums { get; set; } = [];

    protected override void OnInitialized()
    {
        ArtistInfo = Db.Artists.FirstOrDefault(a => a.Id == Id);
        ArtistAlbums = Db.Albums.Where(a => a.ArtistId == Id).ToList();
    }
}