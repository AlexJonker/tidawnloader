@page "/album/{Id:int}"
@using Tidawnloader.Data
@using Tidawnloader.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
<PageTitle>@(AlbumInfo?.Title ?? "Album not found")</PageTitle>

@if (AlbumInfo is null)
{
    <div class="min-h-screen flex items-center justify-center px-4">
        <div class="flex-1 flex flex-col items-center justify-center text-center">
            <h1 class="text-6xl font-bold text-gray-300 mb-4">Album not found</h1>
            <p class="text-gray-400 max-w-xl mb-8">The album you are looking for does not exist in your library.</p>
            <a href="/" class="bg-gray-200 text-black px-5 py-2 font-semibold hover:bg-white transition-colors duration-75 cursor-pointer">Back to library</a>
        </div>
    </div>
}
else
{
    <div class="min-h-screen flex items-center justify-center px-4 flex-col gap-6">
        <img
            src="@($"https://resources.tidal.com/images/{AlbumInfo.Cover.Replace("-", "/")}/750x750.jpg")"
            alt="Picture"
            class="w-48 h-48 object-cover"
        />
        <h1 class="text-4xl font-bold text-gray-200">@AlbumInfo.Title</h1>
        <a href="https://tidal.com/album/@AlbumInfo.Id" target="_blank" class="text-sm text-gray-400">Tidal url</a>
        <a href="https://monochrome.tf/album/@AlbumInfo.Id" target="_blank" class="text-sm text-gray-400">Monochrome url</a>
        <p>@AlbumTracks.Count tracks</p>

        @foreach (var track in AlbumTracks)
        {
            <a href="/track/@track.Id">@track.Title</a>
        }
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private DbAlbum? AlbumInfo { get; set; }
    private List<DbTrack> AlbumTracks { get; set; } = [];

    protected override void OnInitialized()
    {
        AlbumInfo = Db.Albums.FirstOrDefault(a => a.Id == Id);
        AlbumTracks = Db.Tracks.Where(t => t.AlbumId == Id).ToList();
    }
}